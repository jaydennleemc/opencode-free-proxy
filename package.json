{
  "name": "opencode-free-proxy",
  "version": "0.2.3",
  "description": "Proxy server for OpenCode free-tier AI models via Zen API",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "start": "NODE_OPTIONS=--use-openssl-ca node src/index.mjs",
    "dev": "NODE_OPTIONS=--use-openssl-ca node --watch src/index.mjs",
    "start:bun": "bun src/index.mjs",
    "dev:bun": "bun --watch src/index.mjs",
    "test": "METRICS=0 node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
